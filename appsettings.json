{
  "ConnectionStrings": {
    "Default": "Data Source=portfolio.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.TsetmcClient": "Warning",
      "System.Net.Http.HttpClient.BitpinClient": "Warning",
      "System.Net.Http.HttpClient.TgjuClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Tsetmc": {
    "Enabled": true,
    "RunOnStartup": true,
    "Interval": "01:00:00",
    "TradingDays": [ "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday" ],
    "MarketOpen": "08:45",
    "MarketClose": "13:00",
    "SyncEtfNav": true,
    "NavInterval": "01:00:00",
    "NavClose": "18:30",
    "NavConcurrency": 4
  },
  "Bitpin": {
    "Enabled": true,
    "Interval": "00:15:00"
  },
  "Tgju": {
    "Enabled": true,
    "Interval": "00:15:00",
    "MaxQuoteAge": "7.00:00:00"
  },
  "Auth": {
    "SessionLifetime": "08:00:00",
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "Users": []
  },
  "RateLimiting": {
    "Enabled": true,
    "ApiClient": { "PermitLimit": 120, "Window": "00:01:00" },
    "Admin": { "PermitLimit": 600, "Window": "00:01:00" },
    "Anonymous": { "PermitLimit": 30, "Window": "00:01:00" },
    "Auth": { "PermitLimit": 10, "Window": "00:01:00" }
  }
}
