# Copy to .env and fill in. Never commit .env.

# The Portfolio Manager API and an API client account on it (backoffice → Users → New user → role "API client").
Api__BaseUrl=https://portfolio-api.shahabdev.ir
Api__Username=chandoo
Api__Password=

# The site's own address, used in canonical links and the sitemap.
Landing__SiteUrl=https://chandoo.ir

# The app banner's buttons; leave both empty to hide the banner.
Landing__BazaarUrl=
Landing__WebAppUrl=

# Host port the container is published on (localhost only).
HOST_PORT=8081
