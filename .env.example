# Copy to .env and fill in. .env is git-ignored; keep it readable only by you (chmod 600 .env).
# Write values without quotes. Generate passwords with: openssl rand -base64 24
# Settings use "__" for nesting: Auth__Users__0__Username is Auth:Users:0:Username in appsettings.json.

# --- Users ---------------------------------------------------------------------------------------
# Created on startup if they don't exist yet; existing users are never changed. Once the app has
# started, the passwords can be removed from here and managed on the backoffice's Users page.
# Passwords need at least 10 characters.
Auth__Users__0__Username=admin
Auth__Users__0__Password=
Auth__Users__0__Role=Admin

Auth__Users__1__Username=api-client
Auth__Users__1__Password=
Auth__Users__1__Role=ApiClient

# --- Optional overrides (defaults in appsettings.json) -------------------------------------------
# Port on the host (bound to 127.0.0.1) that the reverse proxy forwards to. Read by docker-compose.yml.
#HOST_PORT=8080

# Requests per minute.
#RateLimiting__Anonymous__PermitLimit=30
#RateLimiting__ApiClient__PermitLimit=120
#RateLimiting__Admin__PermitLimit=600
#RateLimiting__Auth__PermitLimit=10

# Browser apps on other origins that may call the API.
#Cors__AllowedOrigins__0=https://portfolio.example.com

# Session and token lifetimes.
#Auth__SessionLifetime=08:00:00
#Auth__AccessTokenLifetime=01:00:00

# Interactive API docs at /swagger.
#Swagger__Enabled=true
